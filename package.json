{
  "name": "nexora-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,blue \"npm run dev -w @nexora/api\" \"npm run dev -w @nexora/web\"",
    "build": "npm run build -w @nexora/shared && npm run build -w @nexora/api && npm run build -w @nexora/web",
    "lint": "eslint . && npm run typecheck",
    "typecheck": "tsc --noEmit -p apps/api && npm run typecheck -w @nexora/web && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "db:local": "tsx scripts/local-db.ts",
    "seed": "npm run seed -w @nexora/api",
    "test:unit": "vitest run --exclude \"**/integration.test.ts\"",
    "test:integration": "vitest run apps/api/test/integration.test.ts",
    "test:e2e:workspace": "E2E_FULL_STACK=1 playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.5",
    "typescript-eslint": "latest",
    "typescript": "latest",
    "tsx": "latest",
    "concurrently": "latest",
    "prettier": "latest",
    "vitest": "latest",
    "supertest": "latest",
    "@types/supertest": "latest",
    "@playwright/test": "latest",
    "mongodb-memory-server": "latest"
  },
  "type": "module",
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": true,
      "version": "8.0.17",
      "checkMD5": true
    }
  }
}
