NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/nexora
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
TRUST_PROXY=0
# Optional: enables the real AI assistant. Never put these in NEXT_PUBLIC_*.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
# Development without SMTP writes emails to apps/api/.local/mail/ (gitignored).
# Production requires an email transport and verified sender by default.
# For a public demo with email delivery disabled, set MAIL_MODE=disabled.
MAIL_FROM=Nexora <hello@your-verified-domain.com>
CONTACT_EMAIL=you@your-domain.com
# HTTPS transport is useful on hosts that restrict SMTP ports.
RESEND_API_KEY=
# Or use Nodemailer SMTP (STARTTLS required except implicit TLS on port 465):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Only for optional local demo seed; never use a privileged real account.
SEED_EMAIL=
SEED_PASSWORD=
